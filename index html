<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zain & Aeman - Wedding Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background: radial-gradient(circle at top, #1a1a1a, #000); min-height:100vh; display:flex; justify-content:center; align-items:center; padding:12px; font-family:'Poppins',sans-serif;}
.card{width:100%; max-width:440px; background:#fdf8e8; border-radius:28px; overflow:hidden; box-shadow:0 0 0 2px #d4af37, 0 0 35px rgba(212,175,55,.6), 0 30px 80px rgba(0,0,0,.8); animation:float 5s ease-in-out infinite;}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.header{background: linear-gradient(135deg, #0f0f0f, #1a1a1a 50%, #1e1e1e); padding:36px 24px 30px; text-align:center; border-bottom:3px solid #d4af37; position:relative;}
.header::before{content:''; position:absolute; top:0; left:0; right:0; height:1px; background: linear-gradient(to right, transparent, #d4af37, transparent);}
.bismillah{font-family:'Amiri',serif; color:#d4af37; font-size:24px; margin-bottom:14px; letter-spacing:1px;}
.couple-head{font-family:'Great Vibes',cursive; font-size:56px; color:#d4af37; line-height:1; text-shadow:0 2px 20px rgba(212,175,55,.4);}
.sub-head{color:#c9a86a; letter-spacing:5px; font-size:11px; margin-top:10px; font-weight:600;}
.ornament{color:#d4af37; margin:14px 0; font-size:18px; letter-spacing:8px;}
.body{padding:28px 24px 24px; text-align:center; background: radial-gradient(circle at center, #fffcf0, #fdf6e3);}
.welcome{color:#8a7a5a; font-size:13px; line-height:1.7; margin-bottom:20px;}
.welcome b{color:#8B0000;}
.badge{display:inline-block; background:#111; color:#d4af37; padding:8px 18px; border-radius:25px; font-size:11px; letter-spacing:2px; border:1px solid #d4af37; margin-bottom:20px; box-shadow:0 2px 10px rgba(0,0,0,.2);}
.btn-main{width:100%; padding:16px; border-radius:14px; border:none; background: linear-gradient(135deg,#b8960c,#d4af37,#f0c75e); color:#000; font-weight:800; font-size:16px; cursor:pointer; box-shadow:0 8px 22px rgba(212,175,55,.5); transition:.2s; letter-spacing:.5px;}
.btn-main:active{transform:scale(.97);}
.btn-sec{width:100%; padding:13px; border-radius:12px; border:1.5px solid #d4af37; background:transparent; color:#8B0000; font-weight:600; font-size:13px; cursor:pointer; margin-top:10px;}
.divider{height:1px; background: linear-gradient(to right, transparent, #d4af37, transparent); margin:22px 0;}
.details-row{display:flex; justify-content:space-between; gap:10px; margin-top:16px;}
.detail-box{flex:1; background:#fff; border-radius:12px; padding:12px 8px; border:1px solid #e9d8a6; box-shadow:0 2px 8px rgba(0,0,0,.04);}
.detail-box .icon{font-size:18px; margin-bottom:4px;}
.detail-box .label{font-size:9px; color:#a99a7a; letter-spacing:1px;}
.detail-box .value{font-size:12px; font-weight:700; color:#3a2e18; margin-top:2px;}
.footer{background:#111; color:#c9a86a; text-align:center; padding:18px; font-size:10px; letter-spacing:3px; border-top:1px solid #d4af37; display:flex; justify-content:center; align-items:center; gap:8px;}
.dot{width:4px; height:4px; background:#d4af37; border-radius:50%;}
</style>
</head>
<body>
<div class="card">
  <div class="header">
    <div class="bismillah">بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ</div>
    <div class="couple-head" id="coupleHead">Zain & Aeman</div>
    <div class="sub-head">ARE GETTING MARRIED</div>
    <div class="ornament">✦ ── ❋ ── ✦</div>
  </div>

  <div class="body">
    <div class="badge" id="badge">WELCOME TO OUR WEDDING</div>
    
    <div class="welcome">
      With the blessings of <b>Allah SWT</b> and our beloved families,<br>
      We cordially invite you to celebrate the most precious day of our lives.<br><br>
      <b style="font-size:15px; color:#8B0000;">Aapki aamad hamare liye baais-e-fakhar hogi</b>
    </div>

    <button class="btn-main" onclick="goToCard()">💌 INVITATION CARD KHOLO</button>
    <button class="btn-sec" onclick="goToAdmin()">Admin Login 🔐</button>

    <div class="divider"></div>

    <div class="details-row">
      <div class="detail-box">
        <div class="icon">📅</div>
        <div class="label">DATE</div>
        <div class="value" id="dateBox">25th Dec 2026</div>
      </div>
      <div class="detail-box">
        <div class="icon">⏰</div>
        <div class="label">TIME</div>
        <div class="value" id="timeBox">07:00 PM</div>
      </div>
      <div class="detail-box">
        <div class="icon">📍</div>
        <div class="label">VENUE</div>
        <div class="value" id="venueBox">Gujranwala</div>
      </div>
    </div>

    <p style="font-size:10px; color:#a99a7a; margin-top:18px;">For personalized invitation with your name & password,<br>contact the host on WhatsApp</p>
  </div>

  <div class="footer">
    <span id="foot1">ZAIN</span> <div class="dot"></div> <span style="color:#d4af37; font-size:14px;">♥</span> <div class="dot"></div> <span id="foot2">AEMAN</span>
  </div>
</div>

<script>
// Config from admin if exists
let cfg = JSON.parse(localStorage.getItem('ZAIN_CFG')||'{}');
if(cfg.c1 && cfg.c2){ document.getElementById('coupleHead').innerText = cfg.c1 + " & " + cfg.c2; document.getElementById('foot1').innerText = cfg.c1.toUpperCase(); document.getElementById('foot2').innerText = cfg.c2.toUpperCase(); }
if(cfg.date) document.getElementById('dateBox').innerText = cfg.date.split(',')[0] || cfg.date;
if(cfg.time) document.getElementById('timeBox').innerText = cfg.time;
if(cfg.venue) document.getElementById('venueBox').innerText = cfg.venue.split(' ')[0];

let qs = new URLSearchParams(location.search);
let to = qs.get('to');
let pass = qs.get('pass');

function goToCard(){
  if(to && pass){
    location.href = `card.html?to=${encodeURIComponent(to)}&pass=${encodeURIComponent(pass)}`;
  } else {
    location.href = `card.html?to=Mehman-e-Khaas&pass=1234`;
  }
}
function goToAdmin(){
  location.href = `admin.html`;
}

// Auto redirect if personalized link
if(to && pass){
  document.getElementById('badge').innerText = `WELCOME ${to.toUpperCase()} ❤️`;
  setTimeout(goToCard, 1200);
}
</script>
</body>
</html>
